# syntax=docker/dockerfile:1
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# bobshell - IBM Bob Shell (agentic CLI) container image
#
# Based on ubi10/nodejs-24, which provides Node.js 24 (Bob Shell requires
# Node.js >= 22.15). Bob Shell is installed with the official installer, the
# IBM license is pre-accepted, and the /workspace directory is pre-trusted so
# the CLI runs non-interactively. acpbox (OpenAI-compatible HTTP gateway to
# the Agent Client Protocol, https://pypi.org/project/acpbox/) is installed
# from PyPI on UBI's Python 3.12.
#
# Build (from this directory):
#   docker build -f Containerfile -t bobshell .
#
# Pin a Bob Shell version:
#   docker build --build-arg BOB_VERSION=2.0.5 -t bobshell .
# Pin acpbox similarly:
#   docker build --build-arg ACPBOX_VERSION=0.2.3 -t bobshell .
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

FROM registry.access.redhat.com/ubi10/nodejs-24-minimal:latest

# Workspace Bob Shell operates in. Owned by the default user (1001), group
# root with g=u so arbitrary UIDs in gid 0 (OpenShift-style) can also use it.
USER root
RUN mkdir -p /workspace \
    && chown 1001:0 /workspace \
    && chmod g=u /workspace
COPY --chmod=0755 entrypoint.sh /usr/local/bin/bob-entrypoint

# Install acpbox (https://pypi.org/project/acpbox/), the OpenAI-compatible
# HTTP gateway to the Agent Client Protocol. It needs Python >= 3.11, which
# UBI 10 provides as Python 3.12. Installed system-wide so `acpbox` is on
# PATH for the runtime user; pip itself is removed afterwards to keep the
# runtime image lean. Note acpbox has no --version/--help flags: any
# invocation boots the gateway, which expects an ACP agent command
# (ACPBOX_ACP_COMMAND or a config.yaml) at runtime.
ARG ACPBOX_VERSION=""
RUN set -eu; \
    microdnf install -y python3 python3-pip; \
    if [ -n "${ACPBOX_VERSION}" ]; then \
        pip3 install --no-cache-dir --root-user-action=ignore "acpbox==${ACPBOX_VERSION}"; \
    else \
        pip3 install --no-cache-dir --root-user-action=ignore acpbox; \
    fi; \
    microdnf remove -y python3-pip; \
    microdnf clean all; \
    command -v acpbox; \
    python3 -c "import acpbox.main"

# Configure acpbox to drive Bob Shell: each gateway worker spawns one
# `bob acp` process (ACP over stdio) at startup, with sessions rooted at the
# pre-trusted /workspace (acpbox's default ./workspace would resolve to
# /workspace/workspace in this image). Both are overridable at runtime with
# `docker run -e`. (Single quotes: Docker's ENV parser strips inner double
# quotes, which would corrupt the JSON array acpbox expects.)
# --trust: `bob acp` rejects session/new for untrusted workspaces and does
# not consult ~/.bob/trustedFolders.json, so the flag is the only headless
# path. It trusts every workspace the ACP server opens, but acpbox always
# pins the session cwd to ACPBOX_ACP_WORKSPACE, so in practice only
# /workspace is trusted — matching this image's documented pre-trust scope.
ENV ACPBOX_ACP_COMMAND='["bob","acp","--trust"]'
ENV ACPBOX_ACP_WORKSPACE=/workspace

# acpbox publishes its OpenAI-compatible API on TCP 8080 (binds 0.0.0.0;
# override with ACPBOX_GATEWAY_PORT). Bob Shell itself listens on no port.
# EXPOSE is documentation only — publish with `docker run -p 8080:8080`.
EXPOSE 8080

USER 1001

# Install Bob Shell via the official installer. The installer verifies the
# package SHA256 and runs `npm install -g`; the image's npm global prefix
# (/opt/app-root/src/.npm-global) is writable by user 1001 and on PATH.
ARG BOB_VERSION=""
RUN set -eu; \
    curl -fsSL https://bob.ibm.com/download/bobshell.sh -o /tmp/bobshell.sh; \
    if [ -n "${BOB_VERSION}" ]; then \
        bash /tmp/bobshell.sh --pm npm --version "${BOB_VERSION}"; \
    else \
        bash /tmp/bobshell.sh --pm npm; \
    fi; \
    rm -f /tmp/bobshell.sh /tmp/bobshell-*.tgz /tmp/bobshell-install.log; \
    command -v bob; \
    bob --version

# Pre-accept the IBM license and pre-trust /workspace from the command line
# so Bob Shell never blocks on first-run prompts. State file formats match
# what Bob Shell 2.0.x itself writes:
#   ~/.bob/settings/settings.json  <- "licenseConsent": true  (`bob --accept-license`)
#   ~/.bob/trustedFolders.json     <- path -> "TRUST_PARENT"  (`bob chat --trust`)
# The default CMD also passes --accept-license/--trust, so a fresh volume
# mounted over $HOME (shadowing these files) still starts without prompts.
RUN mkdir -p "${HOME}/.bob/settings" \
    && printf '{\n  "licenseConsent": true\n}\n' > "${HOME}/.bob/settings/settings.json" \
    && printf '{\n  "/workspace": "TRUST_PARENT"\n}\n' > "${HOME}/.bob/trustedFolders.json"

WORKDIR /workspace

LABEL org.opencontainers.image.title="bobshell"
LABEL org.opencontainers.image.description="IBM Bob Shell agentic CLI on UBI 10 / Node.js 24"
LABEL org.opencontainers.image.source="https://github.com/IBM/contextforge-examples"
LABEL org.opencontainers.image.vendor="IBM"
LABEL org.opencontainers.image.licenses="Apache-2.0"

ENTRYPOINT ["bob-entrypoint"]
CMD ["bob", "chat", "--accept-license", "--trust"]
